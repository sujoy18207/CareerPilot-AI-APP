# Copy to .env.local and fill in real values. Never commit secrets.

# Required for mobile builds (Capacitor). Point to your live production API.
NEXT_PUBLIC_API_URL=https://www.careerpilot.cc

# Generate with: openssl rand -hex 32
AUTH_SECRET=replace_with_a_long_random_secret

# MongoDB Atlas (or local) connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/careerpilot?retryWrites=true&w=majority

# Required in production to allow /api/seed (send as x-seed-secret header). Leave unset to disable seeding in prod.
# SEED_SECRET=your_seed_secret_here

# ZenMux / LLM provider
ZENMUX_API_KEY=your_zenmux_api_key_here
ZENMUX_BASE_URL=https://zenmux.ai/api/v1
ZENMUX_MODEL=anthropic/claude-opus-5
ZENMUX_PDF_MODEL=anthropic/claude-opus-5

# PDF.co (optional fallback for PDF text extraction)
PDF_CO_API_KEY=your_pdf_co_api_key_here

# Optional: enables free long-form YouTube course results on /courses
YOUTUBE_API_KEY=your_youtube_data_api_key_here

# Optional job providers (LinkedIn has no public API — use JSearch for LinkedIn/Indeed/Glassdoor)
RAPIDAPI_KEY=your_rapidapi_key_here
# JSEARCH_HOST=jsearch.p.rapidapi.com
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
# ADZUNA_COUNTRY=in
